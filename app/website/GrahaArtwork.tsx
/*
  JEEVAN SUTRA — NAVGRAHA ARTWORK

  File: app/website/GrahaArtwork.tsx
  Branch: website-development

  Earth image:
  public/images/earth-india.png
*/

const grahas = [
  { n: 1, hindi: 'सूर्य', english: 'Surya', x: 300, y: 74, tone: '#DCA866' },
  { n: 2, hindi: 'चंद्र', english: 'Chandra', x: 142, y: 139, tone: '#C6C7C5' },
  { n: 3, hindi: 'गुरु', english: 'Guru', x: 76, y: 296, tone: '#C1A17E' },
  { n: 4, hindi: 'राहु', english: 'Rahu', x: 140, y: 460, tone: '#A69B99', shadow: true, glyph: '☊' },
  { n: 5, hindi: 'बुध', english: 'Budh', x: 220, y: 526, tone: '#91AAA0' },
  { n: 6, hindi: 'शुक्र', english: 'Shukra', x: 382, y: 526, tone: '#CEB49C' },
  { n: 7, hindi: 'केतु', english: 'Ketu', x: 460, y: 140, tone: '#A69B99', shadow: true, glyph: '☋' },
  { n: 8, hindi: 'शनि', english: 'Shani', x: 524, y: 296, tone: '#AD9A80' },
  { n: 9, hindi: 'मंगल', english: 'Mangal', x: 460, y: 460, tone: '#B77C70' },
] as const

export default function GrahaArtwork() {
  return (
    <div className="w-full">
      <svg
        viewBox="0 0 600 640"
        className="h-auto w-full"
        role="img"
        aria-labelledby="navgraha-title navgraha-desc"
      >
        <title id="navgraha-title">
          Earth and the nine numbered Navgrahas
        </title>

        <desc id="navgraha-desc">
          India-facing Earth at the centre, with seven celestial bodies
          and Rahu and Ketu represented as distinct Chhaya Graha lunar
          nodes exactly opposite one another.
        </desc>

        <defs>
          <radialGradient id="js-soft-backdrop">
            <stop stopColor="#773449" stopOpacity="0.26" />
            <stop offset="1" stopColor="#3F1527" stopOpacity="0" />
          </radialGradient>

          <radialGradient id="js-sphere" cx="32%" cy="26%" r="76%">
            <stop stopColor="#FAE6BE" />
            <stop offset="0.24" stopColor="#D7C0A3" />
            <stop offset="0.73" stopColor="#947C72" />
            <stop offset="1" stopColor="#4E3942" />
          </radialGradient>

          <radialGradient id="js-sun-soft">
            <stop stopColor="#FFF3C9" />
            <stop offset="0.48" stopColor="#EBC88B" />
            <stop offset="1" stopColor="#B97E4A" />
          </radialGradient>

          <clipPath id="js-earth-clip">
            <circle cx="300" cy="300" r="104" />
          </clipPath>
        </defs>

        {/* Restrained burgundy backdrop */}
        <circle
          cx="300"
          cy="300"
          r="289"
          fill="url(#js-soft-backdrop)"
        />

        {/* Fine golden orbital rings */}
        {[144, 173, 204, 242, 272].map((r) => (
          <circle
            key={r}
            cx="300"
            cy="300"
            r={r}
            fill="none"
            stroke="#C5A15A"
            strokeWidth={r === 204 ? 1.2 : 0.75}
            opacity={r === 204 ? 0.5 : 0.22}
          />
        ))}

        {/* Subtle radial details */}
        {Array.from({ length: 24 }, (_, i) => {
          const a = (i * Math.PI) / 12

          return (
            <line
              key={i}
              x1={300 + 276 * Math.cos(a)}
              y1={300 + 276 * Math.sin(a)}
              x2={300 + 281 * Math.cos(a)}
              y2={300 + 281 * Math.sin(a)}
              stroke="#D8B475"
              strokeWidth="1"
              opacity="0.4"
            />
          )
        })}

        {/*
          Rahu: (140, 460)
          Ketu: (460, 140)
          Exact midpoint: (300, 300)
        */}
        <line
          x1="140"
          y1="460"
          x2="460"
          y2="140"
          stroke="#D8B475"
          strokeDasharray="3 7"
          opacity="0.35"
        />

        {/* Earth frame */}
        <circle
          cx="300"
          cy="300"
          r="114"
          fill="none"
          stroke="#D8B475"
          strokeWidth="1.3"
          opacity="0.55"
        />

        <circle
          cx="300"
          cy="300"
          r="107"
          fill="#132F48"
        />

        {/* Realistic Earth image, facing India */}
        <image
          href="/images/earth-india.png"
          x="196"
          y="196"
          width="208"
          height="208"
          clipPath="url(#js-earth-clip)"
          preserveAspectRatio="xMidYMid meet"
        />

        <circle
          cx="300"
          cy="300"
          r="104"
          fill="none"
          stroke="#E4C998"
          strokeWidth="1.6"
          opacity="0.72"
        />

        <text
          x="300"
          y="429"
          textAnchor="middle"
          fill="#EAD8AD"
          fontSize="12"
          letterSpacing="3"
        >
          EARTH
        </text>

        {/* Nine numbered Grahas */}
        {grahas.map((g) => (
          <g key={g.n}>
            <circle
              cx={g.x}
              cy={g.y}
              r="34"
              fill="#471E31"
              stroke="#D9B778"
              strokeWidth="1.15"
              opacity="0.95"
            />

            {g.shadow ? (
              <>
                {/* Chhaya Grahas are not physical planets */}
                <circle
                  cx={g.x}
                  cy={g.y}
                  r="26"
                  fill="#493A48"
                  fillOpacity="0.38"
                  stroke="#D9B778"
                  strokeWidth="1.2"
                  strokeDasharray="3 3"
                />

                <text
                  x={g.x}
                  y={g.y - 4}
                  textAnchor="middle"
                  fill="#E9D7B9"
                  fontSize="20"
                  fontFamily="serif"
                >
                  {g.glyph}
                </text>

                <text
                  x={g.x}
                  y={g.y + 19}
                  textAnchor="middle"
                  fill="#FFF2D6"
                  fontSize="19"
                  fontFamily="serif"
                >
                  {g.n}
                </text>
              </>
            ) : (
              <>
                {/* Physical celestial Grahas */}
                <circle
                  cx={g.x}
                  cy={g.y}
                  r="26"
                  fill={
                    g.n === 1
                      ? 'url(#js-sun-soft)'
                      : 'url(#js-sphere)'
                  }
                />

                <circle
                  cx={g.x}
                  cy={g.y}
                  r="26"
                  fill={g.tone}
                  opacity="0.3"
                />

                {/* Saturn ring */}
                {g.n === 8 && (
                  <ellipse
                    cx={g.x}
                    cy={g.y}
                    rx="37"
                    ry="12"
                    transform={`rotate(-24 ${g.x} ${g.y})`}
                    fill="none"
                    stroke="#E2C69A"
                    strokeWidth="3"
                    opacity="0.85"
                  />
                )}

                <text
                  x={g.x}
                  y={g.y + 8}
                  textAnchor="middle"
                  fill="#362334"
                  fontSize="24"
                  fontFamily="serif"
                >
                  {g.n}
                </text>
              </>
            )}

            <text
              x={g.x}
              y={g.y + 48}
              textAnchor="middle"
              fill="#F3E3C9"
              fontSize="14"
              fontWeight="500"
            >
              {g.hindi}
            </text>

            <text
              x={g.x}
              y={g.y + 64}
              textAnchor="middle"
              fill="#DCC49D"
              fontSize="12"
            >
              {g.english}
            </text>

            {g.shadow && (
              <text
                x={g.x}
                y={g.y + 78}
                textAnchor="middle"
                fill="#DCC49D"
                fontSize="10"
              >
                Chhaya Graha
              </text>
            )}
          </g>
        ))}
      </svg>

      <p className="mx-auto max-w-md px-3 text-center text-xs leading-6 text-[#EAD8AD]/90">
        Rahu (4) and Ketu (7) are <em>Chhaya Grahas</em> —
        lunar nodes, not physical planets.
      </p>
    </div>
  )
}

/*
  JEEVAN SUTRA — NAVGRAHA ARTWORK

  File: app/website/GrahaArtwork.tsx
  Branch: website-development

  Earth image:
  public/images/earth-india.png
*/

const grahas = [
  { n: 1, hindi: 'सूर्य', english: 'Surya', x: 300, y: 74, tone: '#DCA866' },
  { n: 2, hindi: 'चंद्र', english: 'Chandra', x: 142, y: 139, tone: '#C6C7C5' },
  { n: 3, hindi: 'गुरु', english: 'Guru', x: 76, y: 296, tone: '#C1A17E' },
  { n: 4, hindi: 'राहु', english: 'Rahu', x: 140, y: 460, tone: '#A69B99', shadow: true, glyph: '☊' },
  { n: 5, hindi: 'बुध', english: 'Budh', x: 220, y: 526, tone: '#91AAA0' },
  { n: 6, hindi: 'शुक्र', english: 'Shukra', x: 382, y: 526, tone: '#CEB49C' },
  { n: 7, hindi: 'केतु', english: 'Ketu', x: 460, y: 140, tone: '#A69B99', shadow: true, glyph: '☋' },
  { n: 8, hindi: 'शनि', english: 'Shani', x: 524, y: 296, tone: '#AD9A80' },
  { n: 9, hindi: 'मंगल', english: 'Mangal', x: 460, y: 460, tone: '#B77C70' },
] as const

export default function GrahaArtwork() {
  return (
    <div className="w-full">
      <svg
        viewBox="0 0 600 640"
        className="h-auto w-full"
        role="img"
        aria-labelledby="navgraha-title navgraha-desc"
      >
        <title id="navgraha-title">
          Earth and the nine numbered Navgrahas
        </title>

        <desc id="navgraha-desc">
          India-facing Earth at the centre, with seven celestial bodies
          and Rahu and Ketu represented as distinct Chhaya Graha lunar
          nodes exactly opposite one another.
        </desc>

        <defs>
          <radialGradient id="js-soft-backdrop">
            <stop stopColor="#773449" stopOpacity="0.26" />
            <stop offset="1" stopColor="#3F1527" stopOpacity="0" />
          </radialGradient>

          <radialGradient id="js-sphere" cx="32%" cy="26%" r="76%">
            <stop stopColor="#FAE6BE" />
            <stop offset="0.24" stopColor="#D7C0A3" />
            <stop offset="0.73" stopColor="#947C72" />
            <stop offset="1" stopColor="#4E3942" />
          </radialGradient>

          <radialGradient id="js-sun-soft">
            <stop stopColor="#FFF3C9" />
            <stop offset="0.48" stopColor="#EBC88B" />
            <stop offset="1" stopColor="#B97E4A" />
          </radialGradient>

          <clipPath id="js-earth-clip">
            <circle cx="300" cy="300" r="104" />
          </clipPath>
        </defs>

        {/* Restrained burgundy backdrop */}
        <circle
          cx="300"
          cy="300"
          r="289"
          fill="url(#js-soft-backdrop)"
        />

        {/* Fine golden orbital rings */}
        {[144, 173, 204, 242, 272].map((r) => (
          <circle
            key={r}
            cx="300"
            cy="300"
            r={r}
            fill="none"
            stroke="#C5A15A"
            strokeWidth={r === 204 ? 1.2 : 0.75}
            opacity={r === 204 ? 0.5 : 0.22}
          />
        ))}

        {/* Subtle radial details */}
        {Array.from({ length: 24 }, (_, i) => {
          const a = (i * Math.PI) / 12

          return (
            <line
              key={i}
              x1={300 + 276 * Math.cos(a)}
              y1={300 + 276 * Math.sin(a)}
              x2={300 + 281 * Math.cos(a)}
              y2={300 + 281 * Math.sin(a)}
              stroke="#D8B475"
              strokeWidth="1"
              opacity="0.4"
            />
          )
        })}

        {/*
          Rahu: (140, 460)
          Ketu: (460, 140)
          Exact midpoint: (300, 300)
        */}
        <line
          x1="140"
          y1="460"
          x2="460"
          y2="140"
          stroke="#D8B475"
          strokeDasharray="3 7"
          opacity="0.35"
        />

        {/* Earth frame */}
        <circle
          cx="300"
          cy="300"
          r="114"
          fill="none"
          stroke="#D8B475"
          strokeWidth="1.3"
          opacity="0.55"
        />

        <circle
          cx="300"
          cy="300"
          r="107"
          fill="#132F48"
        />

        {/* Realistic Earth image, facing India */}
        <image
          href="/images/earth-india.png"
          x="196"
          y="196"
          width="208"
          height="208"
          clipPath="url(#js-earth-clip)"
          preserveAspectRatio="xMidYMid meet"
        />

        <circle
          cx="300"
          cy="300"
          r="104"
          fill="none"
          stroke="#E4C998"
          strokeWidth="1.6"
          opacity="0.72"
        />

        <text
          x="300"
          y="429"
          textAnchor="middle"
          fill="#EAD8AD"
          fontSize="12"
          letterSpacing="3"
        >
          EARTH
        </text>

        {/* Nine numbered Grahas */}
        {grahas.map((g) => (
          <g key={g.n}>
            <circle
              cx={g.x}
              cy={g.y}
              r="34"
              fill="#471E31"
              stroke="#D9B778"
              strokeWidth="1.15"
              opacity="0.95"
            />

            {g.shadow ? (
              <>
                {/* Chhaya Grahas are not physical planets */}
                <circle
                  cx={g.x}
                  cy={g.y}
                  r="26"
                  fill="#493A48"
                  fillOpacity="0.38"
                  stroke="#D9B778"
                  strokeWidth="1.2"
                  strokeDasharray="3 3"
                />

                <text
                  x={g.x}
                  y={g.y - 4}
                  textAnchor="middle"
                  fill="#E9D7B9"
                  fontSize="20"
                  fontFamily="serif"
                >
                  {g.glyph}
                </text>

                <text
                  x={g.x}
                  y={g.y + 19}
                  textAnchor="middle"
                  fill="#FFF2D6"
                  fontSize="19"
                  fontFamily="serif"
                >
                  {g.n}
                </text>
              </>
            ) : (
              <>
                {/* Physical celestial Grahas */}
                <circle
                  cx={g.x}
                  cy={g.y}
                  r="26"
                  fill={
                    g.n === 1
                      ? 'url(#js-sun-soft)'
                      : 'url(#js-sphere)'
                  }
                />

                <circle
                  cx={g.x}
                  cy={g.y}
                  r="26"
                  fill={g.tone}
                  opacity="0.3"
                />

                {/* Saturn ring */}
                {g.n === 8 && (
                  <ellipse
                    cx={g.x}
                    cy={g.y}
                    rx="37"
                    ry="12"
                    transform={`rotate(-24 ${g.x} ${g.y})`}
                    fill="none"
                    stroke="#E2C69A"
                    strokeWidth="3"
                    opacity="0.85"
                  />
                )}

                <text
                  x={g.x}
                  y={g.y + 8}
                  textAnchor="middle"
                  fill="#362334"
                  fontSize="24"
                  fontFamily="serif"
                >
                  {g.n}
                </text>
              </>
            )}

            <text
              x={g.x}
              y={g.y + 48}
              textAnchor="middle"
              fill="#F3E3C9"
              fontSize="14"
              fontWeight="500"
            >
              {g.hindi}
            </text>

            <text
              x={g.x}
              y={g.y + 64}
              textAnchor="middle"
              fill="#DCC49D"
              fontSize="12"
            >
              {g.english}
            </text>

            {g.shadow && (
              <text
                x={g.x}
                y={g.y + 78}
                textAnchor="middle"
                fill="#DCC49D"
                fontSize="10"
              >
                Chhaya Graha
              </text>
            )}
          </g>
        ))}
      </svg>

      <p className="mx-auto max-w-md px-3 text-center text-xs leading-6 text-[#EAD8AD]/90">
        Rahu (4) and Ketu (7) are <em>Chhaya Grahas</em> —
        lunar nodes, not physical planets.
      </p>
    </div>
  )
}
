const grahas = [
  { n: 1, hindi: 'सूर्य', english: 'Surya', x: 300, y: 74, tone: '#DCA866' },
  { n: 2, hindi: 'चंद्र', english: 'Chandra', x: 142, y: 139, tone: '#C6C7C5' },
  { n: 3, hindi: 'गुरु', english: 'Guru', x: 76, y: 296, tone: '#C1A17E' },
  { n: 4, hindi: 'राहु', english: 'Rahu', x: 140, y: 460, tone: '#A69B99', shadow: true, glyph: '☊' },
  { n: 5, hindi: 'बुध', english: 'Budh', x: 220, y: 526, tone: '#91AAA0' },
  { n: 6, hindi: 'शुक्र', english: 'Shukra', x: 382, y: 526, tone: '#CEB49C' },
  { n: 7, hindi: 'केतु', english: 'Ketu', x: 460, y: 140, tone: '#A69B99', shadow: true, glyph: '☋' },
  { n: 8, hindi: 'शनि', english: 'Shani', x: 524, y: 296, tone: '#AD9A80' },
  { n: 9, hindi: 'मंगल', english: 'Mangal', x: 460, y: 460, tone: '#B77C70' },
] as const

export default function GrahaArtwork() {
  return (
    <div className="w-full">
      <svg
        viewBox="0 0 600 640"
        className="h-auto w-full"
        role="img"
        aria-labelledby="navgraha-title navgraha-desc"
      >
        <title id="navgraha-title">
          Earth and the nine numbered Navgrahas
        </title>

        <desc id="navgraha-desc">
          India-facing Earth at the centre, with seven celestial bodies
          and Rahu and Ketu represented as distinct Chhaya Graha lunar
          nodes exactly opposite one another.
        </desc>

        <defs>
          <radialGradient id="js-soft-backdrop">
            <stop stopColor="#773449" stopOpacity="0.26" />
            <stop offset="1" stopColor="#3F1527" stopOpacity="0" />
          </radialGradient>

          <radialGradient id="js-sphere" cx="32%" cy="26%" r="76%">
            <stop stopColor="#FAE6BE" />
            <stop offset="0.24" stopColor="#D7C0A3" />
            <stop offset="0.73" stopColor="#947C72" />
            <stop offset="1" stopColor="#4E3942" />
          </radialGradient>

          <radialGradient id="js-sun-soft">
            <stop stopColor="#FFF3C9" />
            <stop offset="0.48" stopColor="#EBC88B" />
            <stop offset="1" stopColor="#B97E4A" />
          </radialGradient>

          <clipPath id="js-earth-clip">
            <circle cx="300" cy="300" r="104" />
          </clipPath>
        </defs>

        {/* Restrained burgundy backdrop */}
        <circle
          cx="300"
          cy="300"
          r="289"
          fill="url(#js-soft-backdrop)"
        />

        {/* Fine golden orbital rings */}
        {[144, 173, 204, 242, 272].map((r) => (
          <circle
            key={r}
            cx="300"
            cy="300"
            r={r}
            fill="none"
            stroke="#C5A15A"
            strokeWidth={r === 204 ? 1.2 : 0.75}
            opacity={r === 204 ? 0.5 : 0.22}
          />
        ))}

        {/* Subtle radial details */}
        {Array.from({ length: 24 }, (_, i) => {
          const a = (i * Math.PI) / 12

          return (
            <line
              key={i}
              x1={300 + 276 * Math.cos(a)}
              y1={300 + 276 * Math.sin(a)}
              x2={300 + 281 * Math.cos(a)}
              y2={300 + 281 * Math.sin(a)}
              stroke="#D8B475"
              strokeWidth="1"
              opacity="0.4"
            />
          )
        })}

        {/*
          Rahu: (140, 460)
          Ketu: (460, 140)
          Exact midpoint: (300, 300)
        */}
        <line
          x1="140"
          y1="460"
          x2="460"
          y2="140"
          stroke="#D8B475"
          strokeDasharray="3 7"
          opacity="0.35"
        />

        {/* Earth frame */}
        <circle
          cx="300"
          cy="300"
          r="114"
          fill="none"
          stroke="#D8B475"
          strokeWidth="1.3"
          opacity="0.55"
        />

        <circle
          cx="300"
          cy="300"
          r="107"
          fill="#132F48"
        />

        {/* Realistic Earth image, facing India */}
        <image
          href="/images/earth-india.png"
          x="196"
          y="196"
          width="208"
          height="208"
          clipPath="url(#js-earth-clip)"
          preserveAspectRatio="xMidYMid meet"
        />

        <circle
          cx="300"
          cy="300"
          r="104"
          fill="none"
          stroke="#E4C998"
          strokeWidth="1.6"
          opacity="0.72"
        />

        <text
          x="300"
          y="429"
          textAnchor="middle"
          fill="#EAD8AD"
          fontSize="12"
          letterSpacing="3"
        >
          EARTH
        </text>

        {/* Nine numbered Grahas */}
        {grahas.map((g) => (
          <g key={g.n}>
            <circle
              cx={g.x}
              cy={g.y}
              r="34"
              fill="#471E31"
              stroke="#D9B778"
              strokeWidth="1.15"
              opacity="0.95"
            />

            {g.shadow ? (
              <>
                {/* Chhaya Grahas are not physical planets */}
                <circle
                  cx={g.x}
                  cy={g.y}
                  r="26"
                  fill="#493A48"
                  fillOpacity="0.38"
                  stroke="#D9B778"
                  strokeWidth="1.2"
                  strokeDasharray="3 3"
                />

                <text
                  x={g.x}
                  y={g.y - 4}
                  textAnchor="middle"
                  fill="#E9D7B9"
                  fontSize="20"
                  fontFamily="serif"
                >
                  {g.glyph}
                </text>

                <text
                  x={g.x}
                  y={g.y + 19}
                  textAnchor="middle"
                  fill="#FFF2D6"
                  fontSize="19"
                  fontFamily="serif"
                >
                  {g.n}
                </text>
              </>
            ) : (
              <>
                {/* Physical celestial Grahas */}
                <circle
                  cx={g.x}
                  cy={g.y}
                  r="26"
                  fill={
                    g.n === 1
                      ? 'url(#js-sun-soft)'
                      : 'url(#js-sphere)'
                  }
                />

                <circle
                  cx={g.x}
                  cy={g.y}
                  r="26"
                  fill={g.tone}
                  opacity="0.3"
                />

                {/* Saturn ring */}
                {g.n === 8 && (
                  <ellipse
                    cx={g.x}
                    cy={g.y}
                    rx="37"
                    ry="12"
                    transform={`rotate(-24 ${g.x} ${g.y})`}
                    fill="none"
                    stroke="#E2C69A"
                    strokeWidth="3"
                    opacity="0.85"
                  />
                )}

                <text
                  x={g.x}
                  y={g.y + 8}
                  textAnchor="middle"
                  fill="#362334"
                  fontSize="24"
                  fontFamily="serif"
                >
                  {g.n}
                </text>
              </>
            )}

            <text
              x={g.x}
              y={g.y + 48}
              textAnchor="middle"
              fill="#F3E3C9"
              fontSize="14"
              fontWeight="500"
            >
              {g.hindi}
            </text>

            <text
              x={g.x}
              y={g.y + 64}
              textAnchor="middle"
              fill="#DCC49D"
              fontSize="12"
            >
              {g.english}
            </text>

            {g.shadow && (
              <text
                x={g.x}
                y={g.y + 78}
                textAnchor="middle"
                fill="#DCC49D"
                fontSize="10"
              >
                Chhaya Graha
              </text>
            )}
          </g>
        ))}
      </svg>

      <p className="mx-auto max-w-md px-3 text-center text-xs leading-6 text-[#EAD8AD]/90">
        Rahu (4) and Ketu (7) are <em>Chhaya Grahas</em> —
        lunar nodes, not physical planets.
      </p>
    </div>
  )
}
