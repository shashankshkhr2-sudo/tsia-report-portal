'use client'

import { useState } from 'react'
import Link from 'next/link'
import { ArrowLeft, ArrowRight, CheckCircle2 } from 'lucide-react'
import { DobInput } from '@/components/dob-input'

type ServiceCategory = 'free' | 'other'

const services = [
  'Personal Numerology Report',
  'Life Path Guidance',
  'Astrology Consultation',
  'Career & Professional Guidance',
  'Relationship & Family Guidance',
  'Personalized Remedies & Yantras',
]

const inputClass =
  'mt-2 h-12 w-full rounded-xl border border-[#e5d9d2] bg-white px-4 text-sm text-[#3c3030] outline-none focus:border-[#8b3045] focus:ring-2 focus:ring-[#8b3045]/10'

const labelClass =
  'block text-sm font-medium text-[#554748]'

export default function CustomerRegistrationPage() {
  const [fullName, setFullName] = useState('')
  const [currentName, setCurrentName] = useState('')
  const [dob, setDob] = useState('')
  const [gender, setGender] = useState('')
  const [mobile, setMobile] = useState('')
  const [email, setEmail] = useState('')
  const [sameWhatsapp, setSameWhatsapp] = useState(true)
  const [whatsapp, setWhatsapp] = useState('')
  const [category, setCategory] =
    useState<ServiceCategory>('free')
  const [service, setService] = useState('')
  const [consent, setConsent] = useState(false)

  const formValid =
    fullName.trim().length > 1 &&
    Boolean(dob) &&
    (mobile.trim().length > 0 || email.trim().length > 0) &&
    (category === 'free' || Boolean(service)) &&
    consent

  return (
    <main className="min-h-screen bg-[#f9f5ef] text-[#392e30]">
      <header className="border-b border-[#eadfd4] bg-white">
        <div className="mx-auto flex max-w-5xl items-center justify-between px-5 py-5">
          <Link
            href="/website"
            className="font-serif text-2xl font-semibold tracking-wide text-[#762b40]"
          >
            JEEVAN SUTRA
          </Link>

          <Link
            href="/website"
            className="flex items-center gap-2 text-sm font-medium text-[#762b40]"
          >
            <ArrowLeft className="size-4" />
            Home
          </Link>
        </div>
      </header>

      <div className="mx-auto max-w-3xl px-4 py-10 sm:py-14">
        <div className="mb-8 text-center">
          <p className="text-xs font-semibold uppercase tracking-[0.25em] text-[#a57a40]">
            The Complete Guidance Experience
          </p>

          <h1 className="mt-4 font-serif text-4xl font-semibold text-[#762b40] sm:text-5xl">
            Begin Your Journey
          </h1>

          <p className="mx-auto mt-4 max-w-xl text-sm leading-7 text-[#766b67]">
            Create your personal Jeevan Sutra profile to
            explore consultations, personalized guidance
            and our services.
          </p>
        </div>

        <div className="overflow-hidden rounded-3xl border border-[#eadfd4] bg-white shadow-sm">
          <div className="bg-[#762b40] px-6 py-6 text-white sm:px-8">
            <p className="text-xs uppercase tracking-[0.2em] text-[#e8c894]">
              Customer Registration
            </p>

            <h2 className="mt-2 font-serif text-2xl">
              Your Personal Details
            </h2>

            <p className="mt-2 text-sm text-white/75">
              Fields marked * are required.
            </p>
          </div>

          <div className="space-y-8 p-6 sm:p-8">
            <section>
              <h3 className="mb-5 font-serif text-xl font-semibold text-[#762b40]">
                Personal Information
              </h3>

              <div className="grid gap-5 sm:grid-cols-2">
                <label className={`${labelClass} sm:col-span-2`}>
                  Full Name / Birth Name *
                  <input
                    value={fullName}
                    onChange={(e) => setFullName(e.target.value)}
                    placeholder="Enter your full name"
                    className={inputClass}
                  />
                </label>

                <label className={labelClass}>
                  Current Name
                  <input
                    value={currentName}
                    onChange={(e) => setCurrentName(e.target.value)}
                    placeholder="If different"
                    className={inputClass}
                  />
                </label>

                <div>
                  <label className={labelClass}>
                    Date of Birth *
                  </label>
                  <div className="mt-2">
                    <DobInput
                      value={dob}
                      onChange={setDob}
                      required
                    />
                  </div>
                </div>

                <label className={labelClass}>
                  Gender
                  <select
                    value={gender}
                    onChange={(e) => setGender(e.target.value)}
                    className={inputClass}
                  >
                    <option value="">Select</option>
                    <option value="male">Male</option>
                    <option value="female">Female</option>
                    <option value="other">Other</option>
                    <option value="prefer_not_to_say">
                      Prefer not to say
                    </option>
                  </select>
                </label>
              </div>
            </section>

            <section className="border-t border-[#eee5dc] pt-7">
              <h3 className="mb-5 font-serif text-xl font-semibold text-[#762b40]">
                Contact Information
              </h3>

              <div className="grid gap-5 sm:grid-cols-2">
                <label className={labelClass}>
                  Mobile Number
                  <input
                    type="tel"
                    value={mobile}
                    onChange={(e) => setMobile(e.target.value)}
                    placeholder="+91"
                    className={inputClass}
                  />
                </label>

                <label className={labelClass}>
                  Email Address
                  <input
                    type="email"
                    value={email}
                    onChange={(e) => setEmail(e.target.value)}
                    placeholder="you@example.com"
                    className={inputClass}
                  />
                </label>

                <label className="flex items-center gap-3 text-sm text-[#554748] sm:col-span-2">
                  <input
                    type="checkbox"
                    checked={sameWhatsapp}
                    onChange={(e) =>
                      setSameWhatsapp(e.target.checked)
                    }
                    className="size-4 accent-[#762b40]"
                  />
                  WhatsApp number is the same as mobile
                </label>

                {!sameWhatsapp && (
                  <label className={`${labelClass} sm:col-span-2`}>
                    WhatsApp Number
                    <input
                      type="tel"
                      value={whatsapp}
                      onChange={(e) => setWhatsapp(e.target.value)}
                      placeholder="+91"
                      className={inputClass}
                    />
                  </label>
                )}
              </div>
            </section>

            <section className="border-t border-[#eee5dc] pt-7">
              <h3 className="mb-5 font-serif text-xl font-semibold text-[#762b40]">
                Choose Your Service
              </h3>

              <div className="grid gap-3 sm:grid-cols-2">
                <button
                  type="button"
                  onClick={() => setCategory('free')}
                  className={`rounded-2xl border p-5 text-left transition ${
                    category === 'free'
                      ? 'border-[#762b40] bg-[#fcf2f3]'
                      : 'border-[#e8ddd4] bg-white'
                  }`}
                >
                  <span className="font-semibold">
                    Free Consultation
                  </span>
                  <p className="mt-2 text-xs leading-5 text-[#827571]">
                    Begin with an introductory numerology consultation.
                  </p>
                </button>

                <button
                  type="button"
                  onClick={() => setCategory('other')}
                  className={`rounded-2xl border p-5 text-left transition ${
                    category === 'other'
                      ? 'border-[#762b40] bg-[#fcf2f3]'
                      : 'border-[#e8ddd4] bg-white'
                  }`}
                >
                  <span className="font-semibold">
                    Other Services
                  </span>
                  <p className="mt-2 text-xs leading-5 text-[#827571]">
                    Explore our personalized guidance services.
                  </p>
                </button>
              </div>

              {category === 'other' && (
                <label className={`${labelClass} mt-5`}>
                  Select Service *
                  <select
                    value={service}
                    onChange={(e) => setService(e.target.value)}
                    className={inputClass}
                  >
                    <option value="">Choose a service</option>
                    {services.map((item) => (
                      <option key={item} value={item}>
                        {item}
                      </option>
                    ))}
                  </select>
                </label>
              )}
            </section>

            <section className="border-t border-[#eee5dc] pt-7">
              <label className="flex items-start gap-3 text-sm leading-6 text-[#665a56]">
                <input
                  type="checkbox"
                  checked={consent}
                  onChange={(e) => setConsent(e.target.checked)}
                  className="mt-1 size-4 shrink-0 accent-[#762b40]"
                />

                <span>
                  I agree to provide my information for
                  Jeevan Sutra registration and service-related
                  communication. I understand that I can
                  request corrections to my personal details.
                </span>
              </label>
            </section>

            <div className="rounded-xl border border-[#e8dcc9] bg-[#fbf7ee] p-4">
              <div className="flex gap-3">
                <CheckCircle2 className="mt-0.5 size-5 shrink-0 text-[#a57a40]" />
                <p className="text-xs leading-6 text-[#776a5e]">
                  Your registration will create or securely link
                  your personal customer profile. Your
                  information will not be displayed to other
                  customers.
                </p>
              </div>
            </div>

            <button
              type="button"
              disabled
              title="Registration will be enabled after secure backend integration."
              className="flex h-13 w-full items-center justify-center gap-3 rounded-xl bg-[#762b40] px-6 py-4 font-semibold text-white opacity-60"
            >
              Save & Continue
              <ArrowRight className="size-5" />
            </button>

            <p className="text-center text-xs text-[#91837d]">
              Secure registration is being prepared.
            </p>

            {!formValid && (
              <p className="text-center text-xs text-[#91837d]">
                Complete the required fields to prepare your registration.
              </p>
            )}
          </div>
        </div>

        <p className="mt-8 text-center text-xs text-[#91837d]">
          © Jeevan Sutra · The Complete Guidance Experience
        </p>
      </div>
    </main>
  )
}